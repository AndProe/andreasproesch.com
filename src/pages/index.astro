---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { portfolio } from '../data/portfolio';
import '../styles/home.css';

// Latest native essays (canonical on this domain).
const recentPosts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const ymd = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');

// Proof points. Numeric values count up on reveal (data-count); text values are static.
const stats: { value: string; label: string; count?: number; suffix?: string }[] = [
  { value: '15+', count: 15, suffix: '+', label: 'Years at the intersection of tech & industry' },
  { value: 'EU · GCC', label: 'Keynotes & briefings across Europe and the Middle East' },
  { value: 'Gov · Ent · VC', label: 'Advisory for governments, enterprises & funds' },
  { value: String(portfolio.length), count: portfolio.length, label: 'Early-stage companies backed as an angel' },
];

const experienceMarks = ['AI71', 'Cognite', 'Aker', 'AkerBP', 'BCG'];

const stripPhotos = [
  { src: '/images/speaking-event-1.jpg' },
  { src: '/images/speaking-event-6.jpg' },
  { src: '/images/speaking-event-8.jpg' },
  { src: '/images/speaking-event-4.jpg' },
];
---

<BaseLayout
  title="AI Advisor, Speaker & Angel Investor · Abu Dhabi"
  description="Andreas Proesch helps governments, enterprises, and investors turn AI ambition into shipped systems. Head of Programs, Applied AI Products at AI71, Abu Dhabi. Advisory, keynotes, and angel investing."
>

  <!-- ===================== HERO ===================== -->
  <section class="hero hero--intro section">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Turning AI ambition into shipped systems</p>
        <h1 class="hero__name">
          <span class="ln"><span class="ln__in">Andreas</span></span>
          <span class="ln ln--out"><span class="ln__in">Proesch</span></span>
        </h1>
        <p class="hero__role mono">// For governments, enterprises, investors &amp; founders</p>
        <p class="hero__intro">
          I'm <span class="amber">Head of Programs, Applied AI Products at AI71</span> in Abu Dhabi.
          I help organizations move from AI experimentation to AI-first operating models — and I speak,
          advise, and invest where AI meets industry and capital.
        </p>

        <dl class="facts">
          <div class="facts__row"><dt>Current</dt><dd>Applied AI · AI71</dd></div>
          <div class="facts__row"><dt>Based in</dt><dd>Abu Dhabi, UAE</dd></div>
          <div class="facts__row"><dt>Focus</dt><dd>Industrial &amp; Sovereign AI</dd></div>
        </dl>

        <div class="hero__cta">
          <a class="btn btn--primary" href="/contact/">Work with me <span class="arr">→</span></a>
          <a class="btn" href="/speaking/">Invite me to speak</a>
        </div>
      </div>

      <div class="hero__portrait">
        <div class="framed">
          <span class="brk tl"></span><span class="brk br"></span>
          <div class="ph" style="aspect-ratio: 4/5;">
            <img src="/images/andreas-portrait.jpg" alt="Portrait of Andreas Proesch" width="498" height="623" loading="eager"
                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
            <span class="ph__label" style="display:none;"><b>andreas-portrait.jpg</b>Portrait · 4:5</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== EXPERIENCE MARKS + STATS ===================== -->
  <section class="section proof" id="proof">
    <div class="wrap">
      <div class="marks" data-reveal="fade">
        <span class="marks__label mono">Experience across</span>
        <ul class="marks__list">
          {experienceMarks.map(m => <li>{m}</li>)}
        </ul>
      </div>

      <dl class="stats" data-reveal-group>
        {stats.map(s => (
          <div class="stats__item" data-reveal>
            <dt class="stats__label">{s.label}</dt>
            <dd class="stats__value" data-count={s.count} data-suffix={s.suffix}>{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ===================== 01 / WORK WITH ME (buyer-segmented offers) ===================== -->
  <section class="section section--tight" id="work">
    <div class="wrap">
      <div class="sec-head" data-reveal="clip">
        <span class="sec-head__num">01 / Work With Me</span>
        <h2>Three ways in</h2>
      </div>
      <div class="roles" data-reveal-group>
        <a class="card role" href="/contact/" data-reveal>
          <div class="role__top">
            <span class="role__idx mono">/01</span>
            <span class="role__verb mono">For enterprises, governments &amp; funds</span>
          </div>
          <h3 class="role__name">Advisory</h3>
          <p class="role__body">AI strategy, diligence, and the path from pilots to production-grade systems — grounded in operating experience, not slideware.</p>
          <span class="role__go mono">Start a conversation <span class="arr">→</span></span>
        </a>
        <a class="card role" href="/speaking/" data-reveal>
          <div class="role__top">
            <span class="role__idx mono">/02</span>
            <span class="role__verb mono">For conferences, boards &amp; executive teams</span>
          </div>
          <h3 class="role__name">Speaking</h3>
          <p class="role__body">Keynotes, panels, and private briefings on AI adoption, sovereign AI, and what it takes to actually ship — across Europe and the Middle East.</p>
          <span class="role__go mono">Book a talk <span class="arr">→</span></span>
        </a>
        <a class="card role" href="/portfolio/" data-reveal>
          <div class="role__top">
            <span class="role__idx mono">/03</span>
            <span class="role__verb mono">For founders</span>
          </div>
          <h3 class="role__name">Angel</h3>
          <p class="role__body">Early cheques and hands-on help with product direction, technical strategy, and go-to-market — from humanoid robotics to nuclear fusion.</p>
          <span class="role__go mono">See the portfolio <span class="arr">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== 02 / THE LENS ===================== -->
  <section class="section lens" id="lens">
    <div class="wrap lens__grid">
      <div class="lens__copy">
        <div class="sec-head" data-reveal="clip">
          <span class="sec-head__num">02 / The Lens</span>
          <h2>Supply Chains of Intelligence</h2>
        </div>
        <p class="lens__p" data-reveal data-delay="0.05">
          Energy, compute, data, models, software, and decision-making aren't separate markets — they're
          one chain. Each layer feeds the next, and a constraint in any single layer caps the whole.
        </p>
        <p class="lens__p" data-reveal data-delay="0.1">
          I track where value, risk, and leverage relocate as the chain matures — which layer becomes
          scarce, which gets commoditized, and where one decision compounds across everything downstream.
        </p>
      </div>

      <div class="lens__diagram" data-reveal="scale" data-delay="0.1">
        <svg viewBox="0 0 420 420" role="img" aria-label="Node graph: Energy, Compute, Data, Models and Software wired into a central Decision-making node">
          <defs>
            <radialGradient id="coreGlow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#F0893C" stop-opacity="0.35" />
              <stop offset="100%" stop-color="#F0893C" stop-opacity="0" />
            </radialGradient>
          </defs>
          <!-- wires -->
          <g stroke="#2B333A" stroke-width="1" fill="none">
            <line x1="210" y1="210" x2="210" y2="58" />
            <line x1="210" y1="210" x2="354" y2="138" />
            <line x1="210" y1="210" x2="330" y2="320" />
            <line x1="210" y1="210" x2="90" y2="320" />
            <line x1="210" y1="210" x2="66" y2="138" />
          </g>
          <!-- animated pulses along wires -->
          <g fill="#F0893C">
            <circle r="2.5" class="pulse"><animateMotion dur="3.2s" repeatCount="indefinite" path="M210,210 L210,58" /></circle>
            <circle r="2.5" class="pulse"><animateMotion dur="3.8s" repeatCount="indefinite" path="M210,210 L354,138" /></circle>
            <circle r="2.5" class="pulse"><animateMotion dur="3.4s" repeatCount="indefinite" path="M210,210 L330,320" /></circle>
            <circle r="2.5" class="pulse"><animateMotion dur="4.1s" repeatCount="indefinite" path="M210,210 L90,320" /></circle>
            <circle r="2.5" class="pulse"><animateMotion dur="3.6s" repeatCount="indefinite" path="M210,210 L66,138" /></circle>
          </g>
          <!-- outer nodes -->
          <g class="gnode"><circle cx="210" cy="58" r="6" /><text x="210" y="38">Energy</text></g>
          <g class="gnode"><circle cx="354" cy="138" r="6" /><text x="354" y="118">Compute</text></g>
          <g class="gnode"><circle cx="330" cy="320" r="6" /><text x="330" y="346">Data</text></g>
          <g class="gnode"><circle cx="90" cy="320" r="6" /><text x="90" y="346">Models</text></g>
          <g class="gnode"><circle cx="66" cy="138" r="6" /><text x="66" y="118">Software</text></g>
          <!-- core -->
          <circle cx="210" cy="210" r="60" fill="url(#coreGlow)" />
          <circle cx="210" cy="210" r="34" fill="#0B0D0F" stroke="#F0893C" stroke-width="1.5" />
          <text class="core" x="210" y="206">Decision-</text>
          <text class="core" x="210" y="220">making</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- ===================== 03 / EXPERIENCE ===================== -->
  <section class="section section--tight" id="experience">
    <div class="wrap">
      <div class="sec-head" data-reveal="clip">
        <span class="sec-head__num">03 / Experience</span>
        <h2>Professional background</h2>
      </div>
      <ol class="xp" data-reveal-group>
        <li class="xp__item" data-reveal>
          <span class="xp__when mono">Present</span>
          <div class="xp__main"><h3>Head of Programs, Applied AI Products</h3><span class="xp__org">AI71</span></div>
          <span class="xp__tag mono">Sovereign Agentic AI</span>
        </li>
        <li class="xp__item" data-reveal>
          <span class="xp__when mono">Prev</span>
          <div class="xp__main"><h3>VP &amp; Head of Aker AI Unit</h3><span class="xp__org">Cognite &amp; Aker ASA</span></div>
          <span class="xp__tag mono">Industrial AI · DataOps</span>
        </li>
        <li class="xp__item" data-reveal>
          <span class="xp__when mono">Prev</span>
          <div class="xp__main"><h3>Snr. Finance, Digital Investments</h3><span class="xp__org">AkerBP</span></div>
          <span class="xp__tag mono">Energy</span>
        </li>
        <li class="xp__item" data-reveal>
          <span class="xp__when mono">Prev</span>
          <div class="xp__main"><h3>Project Leader</h3><span class="xp__org">Boston Consulting Group</span></div>
          <span class="xp__tag mono">Management Consulting</span>
        </li>
      </ol>
      <a class="btn xp__more" href="/about/#experience">Full background &amp; education <span class="arr">→</span></a>
    </div>
  </section>

  <!-- ===================== 04 / FOCUS AREAS ===================== -->
  <section class="section section--tight" id="focus">
    <div class="wrap">
      <div class="sec-head" data-reveal="clip">
        <span class="sec-head__num">04 / Focus Areas</span>
        <h2>Where I spend my attention</h2>
      </div>
      <ul class="chips" data-reveal>
        <li>AI Transformation</li>
        <li>Co-Innovation</li>
        <li>Agentic AI Adoption</li>
        <li>Robotics &amp; Automation</li>
        <li>Industrial AI</li>
        <li>Energy &amp; Manufacturing</li>
        <li>Tech Trends</li>
        <li>Commodity Markets</li>
      </ul>
    </div>
  </section>

  <!-- ===================== 05 / WRITING — ASYMMETRIC ===================== -->
  <section class="section" id="writing">
    <div class="wrap">
      <div class="sec-head writing__head" data-reveal="clip">
        <div>
          <span class="sec-head__num">05 / Writing — Asymmetric</span>
          <h2>Notes on AI, industry &amp; capital</h2>
        </div>
        <a class="btn" href="/blog/">All writing <span class="arr">→</span></a>
      </div>
      <ul class="posts" data-reveal-group>
        {recentPosts.map(post => (
          <li class="card post" data-reveal>
            <a href={`/blog/${post.id}/`}>
              <span class="post__date mono"><time datetime={post.data.date.toISOString()}>{ymd(post.data.date)}</time></span>
              <h3 class="post__title">{post.data.title}</h3>
              <span class="post__go mono">Read the essay <span class="arr">→</span></span>
            </a>
          </li>
        ))}
      </ul>

      <div class="newsletter" data-reveal>
        <div class="newsletter__copy">
          <p class="eyebrow">Subscribe</p>
          <h3 class="newsletter__h">Asymmetric — AI, industry &amp; capital</h3>
          <p class="newsletter__p">Essays and signals for operators and investors. No noise — delivered when they're worth your time.</p>
        </div>
        <div class="newsletter__embed">
          <iframe src="https://proesch.substack.com/embed" title="Subscribe to Asymmetric on Substack"
                  frameborder="0" scrolling="no" loading="lazy"></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== 06 / ON STAGE ===================== -->
  <section class="section section--tight" id="stage">
    <div class="wrap">
      <div class="sec-head" data-reveal="clip">
        <span class="sec-head__num">06 / On Stage</span>
        <h2>From past events</h2>
      </div>
      <a class="photostrip" href="/speaking/" data-reveal aria-label="See the speaking page">
        {stripPhotos.map((p, i) => (
          <span class="photostrip__cell">
            <img src={p.src} alt="" width="1000" height="750" loading="lazy" decoding="async" />
          </span>
        ))}
      </a>
      <p class="mono photostrip__more" data-reveal><a href="/speaking/">Topics, formats &amp; booking <span class="arr">→</span></a></p>
    </div>
  </section>

  <!-- ===================== CONTACT ===================== -->
  <section class="section contact-cta">
    <div class="wrap contact-cta__inner" data-reveal>
      <div>
        <p class="eyebrow">Contact</p>
        <h2 class="contact-cta__h">Get in touch</h2>
        <p class="contact-cta__p">Advisory for enterprises, governments &amp; funds · keynotes and briefings · early-stage companies.</p>
      </div>
      <a class="btn btn--primary" href="/contact/">Work with me <span class="arr">→</span></a>
    </div>
  </section>

</BaseLayout>
