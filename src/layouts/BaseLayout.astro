---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Extra JSON-LD blocks for this page (e.g. Article, FAQPage, BreadcrumbList). */
  jsonLd?: Record<string, any>[];
}

const {
  title,
  description = "Andreas Proesch — Tech Operator, Advisor, and Angel Investor working where AI meets industry and capital. Head of Programs, Applied AI Products at AI71, Abu Dhabi.",
  image = "/images/og-card.png",
  jsonLd = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const fullTitle = `${title} | Andreas Proesch`;

// Stable @id so page-level Article/FAQ blocks can reference the same Person entity.
const PERSON_ID = "https://andreasproesch.com/#andreas";

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": PERSON_ID,
  "name": "Andreas Proesch",
  "url": "https://andreasproesch.com",
  "image": "https://andreasproesch.com/images/andreas-portrait.jpg",
  "jobTitle": "Head of Programs, Applied AI Products",
  "worksFor": {
    "@type": "Organization",
    "name": "AI71",
    "url": "https://ai71.ai"
  },
  "homeLocation": {
    "@type": "Place",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Abu Dhabi",
      "addressCountry": "AE"
    }
  },
  "alumniOf": [
    { "@type": "CollegeOrUniversity", "name": "INSEAD" },
    { "@type": "CollegeOrUniversity", "name": "Imperial College London" }
  ],
  "description": "Tech operator, advisor, and angel investor working where AI meets industry and capital, with a focus on the Middle East, the GCC, and the UAE.",
  "sameAs": [
    "https://www.linkedin.com/in/andreasproesch",
    "https://x.com/andreasproesch",
    "https://proesch.substack.com",
    "https://linktr.ee/andreasproesch",
    "https://www.instagram.com/andreasproesch"
    // TODO (Workstream E): add Wikidata item URL once created.
  ],
  "knowsAbout": [
    "Artificial Intelligence",
    "Sovereign AI",
    "Agentic AI",
    "AI Adoption",
    "AI Governance",
    "Industrial AI",
    "Robotics",
    "Technology Strategy",
    "Angel Investing",
    "AI in the Middle East",
    "AI in the GCC",
    "AI in the UAE"
  ]
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://andreasproesch.com/#website",
  "url": "https://andreasproesch.com",
  "name": "Andreas Proesch",
  "publisher": { "@id": PERSON_ID }
};

// Default entity graph + any page-specific blocks.
const schemas = [person, website, ...jsonLd];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0B0D0F" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Capability flags before first paint: .js gates reveal hiding, .fine gates pointer effects -->
    <script is:inline>
      (function (h) {
        h.classList.add("js");
        if (matchMedia("(hover: hover) and (pointer: fine)").matches) h.classList.add("fine");
      })(document.documentElement);
    </script>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Andreas Proesch" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data (Person + WebSite + any page-specific blocks) -->
    {schemas.map(s => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <title>{fullTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="nav-sentinel" aria-hidden="true"></div>
    <div class="atmosphere" aria-hidden="true">
      <div class="grid"><span class="grid__spot"></span></div>
      <div class="grain"></div>
    </div>

    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main class="page" id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script data-goatcounter="https://andreasproesch.goatcounter.com/count"
        async src="//gc.zgo.at/count.js" is:inline></script>

    <!-- Shared site behaviour (bundled): menu, clock, reveal, pointer effects, counters -->
    <script src="../scripts/main.ts"></script>
  </body>
</html>
